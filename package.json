{
  "name": "drivenest-rental-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/web run dev",
    "build": "npm --workspace=apps/web run build",
    "start": "npm --workspace=apps/web run start",
    "lint": "npm --workspace=apps/web run lint",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:seed": "npx ts-node --project tsconfig.json prisma/seed.ts"
  },
  "prisma": {
    "seed": "npx ts-node --project tsconfig.json prisma/seed.ts"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
