# DriveNest Database Configuration
# In production, use strong credentials and secure SSL mode.

DATABASE_URL="postgresql://drivenest:drivenest@localhost:5432/drivenest?schema=public"

# Session & Token Secret (for API authentication in Phase 2)
AUTH_SECRET="development-auth-secret-min-32-chars-long"

# Authoritative Business Timezone
TZ="Asia/Kolkata"
